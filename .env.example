# Database (PostgreSQL)
# Local Docker: npm run db:up  (port 5433)
# Vercel: use Neon/Supabase — set BOTH URLs in Vercel Project Env
# Neon example:
# DATABASE_URL="postgresql://USER:PASS@HOST/db?sslmode=require&pgbouncer=true&connect_timeout=15"
# DIRECT_URL="postgresql://USER:PASS@HOST/db?sslmode=require"
DATABASE_URL="postgresql://packaginghype:packaginghype@127.0.0.1:5433/packaginghype?schema=public"
DIRECT_URL="postgresql://packaginghype:packaginghype@127.0.0.1:5433/packaginghype?schema=public"

# App URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Admin auth (required for /admin)
ADMIN_SESSION_SECRET="change-me-to-a-long-random-secret"
ADMIN_EMAIL="admin@packaginghype.com"
ADMIN_PASSWORD="Admin@12345"

# Cloudinary (Media Storage & Delivery)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Resend (Email Notifications for Quotes)
RESEND_API_KEY=""
QUOTE_NOTIFICATION_EMAIL="info@packaginghype.com"
